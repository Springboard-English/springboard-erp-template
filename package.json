{
    "name": "@springboard-english/springboard-erp-template",
    "private": false,
    "version": "6.9.2",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/Springboard-English/springboard-erp-template.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "bin"
    ],
    "bin": {
        "sb-register-oidc-scopes": "bin/register-oidc-scopes.mjs"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/exports.d.ts",
    "exports": {
        ".": {
            "types": "./dist/exports.d.ts",
            "import": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core.js"
        },
        "./exercise": {
            "types": "./dist/exercise/index.d.ts",
            "import": "./dist/exercise.js"
        },
        "./feedback": {
            "types": "./dist/feedback/index.d.ts",
            "import": "./dist/feedback.js"
        },
        "./test-setup": "./dist/test-setup.js",
        "./style.css": "./dist/springboard-erp-template.css",
        "./tokens.css": "./dist/tokens.css",
        "./exercise.css": "./dist/exercise.css",
        "./push-sw.js": "./dist/push-sw.js",
        "./favicon.svg": "./dist/favicon.svg",
        "./vite": {
            "types": "./dist/vite-boot.d.mts",
            "import": "./dist/vite-boot.mjs"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-node-safe.mjs && node scripts/check-dts-portable.mjs && node scripts/check-core-pure.mjs",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx",
        "test": "vitest run"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@formbricks/js": "5.1.0",
        "@radix-ui/react-popover": "^1.1.15",
        "@react-spring/web": "^10.0.3",
        "@tanstack/react-virtual": "^3.14.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.19",
        "i18next": "^26.3.1",
        "libphonenumber-js": "^1.13.14",
        "lucide-react": "^1.7.0",
        "modern-screenshot": "^4.7.0",
        "radix-ui": "^1.4.3",
        "react-i18next": "^17.0.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.90.21",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.18.2",
        "zod": "^4.4.3"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/react-query": "^5.90.21",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "jsdom": "^29.1.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.18.2",
        "shadcn": "^4.1.2",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.2",
        "vitest": "^4.1.9",
        "zod": "^4.6.7"
    }
}
